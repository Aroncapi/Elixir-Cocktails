# Copiar a .env y completar. .env esta en .gitignore (NUNCA subirlo).
# docker compose lee .env automaticamente desde la raiz del proyecto.

# Secreto para firmar JWTs (obligatorio en produccion).
# Generar con: openssl rand -base64 48
JWT_SECRET=

# Password del root de MySQL (el healthcheck y el container la usan).
# Si se cambia DESPUES de la primera ejecucion, hay que actualizarla
# tambien dentro del contenedor: ALTER USER 'root'@'localhost' IDENTIFIED BY '<nueva>';
MYSQL_ROOT_PASSWORD=root

# URL publica del sitio (los links de seguimiento/WhatsApp/PDF la usan).
# Local:  http://localhost     |  Nube:  http://<IP-del-servidor>
PUBLIC_URL=http://localhost

# Origenes permitidos por CORS (separados por coma).
# Local:  http://localhost:4200,https://localhost:4200,http://localhost
# Nube:   http://<IP-del-servidor>
CORS_ORIGINS=http://localhost:4200,https://localhost:4200,http://localhost

# Correo del admin que recibe las notificaciones.
ADMIN_EMAIL=admin@velvet.mx
